# FinRAG-X environment configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real keys.

# Required: Your Groq API key (https://console.groq.com)
LLM_API_KEY=your_groq_api_key_here

# Optional: Override the default LLM model
# FINRAG_MODEL=openai/gpt-oss-20b
